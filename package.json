    "firebase-admin": "^12.7.0",
    "helmet": "^7.2.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.22.0",
    "socket.io": "^4.8.1",
    "twilio": "^5.4.0",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
