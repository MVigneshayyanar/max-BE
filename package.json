{
  "name": "maxmybill-backend",
  "version": "1.0.0",
  "description": "MAXmybill Backend API - Node.js + Express + Neon PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "npx prisma migrate deploy",
